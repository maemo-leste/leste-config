SectionVerb {
	EnableSequence [
		cset "name='Earpiece Mixer Voice Switch' off"
		cset "name='Earpiece Mixer HiFi Switch' off"
		cset "name='Earpiece Mixer Ext Switch' off"

		cset "name='Speaker Right Mixer Voice Switch' off"
		cset "name='Speaker Right Mixer HiFi Switch' off"
		cset "name='Speaker Right Mixer Ext Switch' off"
		cset "name='Speaker Left Mixer Voice Switch' off"
		cset "name='Speaker Left Mixer HiFi Switch' off"
		cset "name='Speaker Left Mixer Ext Switch' off"

		cset "name='Lineout Right Mixer Voice Switch' off"
		cset "name='Lineout Right Mixer HiFi Switch' off"
		cset "name='Lineout Right Mixer Ext Switch' off"
		cset "name='Lineout Left Mixer Voice Switch' off"
		cset "name='Lineout Left Mixer HiFi Switch' off"
		cset "name='Lineout Left Mixer Ext Switch' off"

		cset "name='Headset Right Mixer Voice Switch' off"
		cset "name='Headset Right Mixer HiFi Switch' off"
		cset "name='Headset Right Mixer Ext Switch' off"
		cset "name='Headset Left Mixer Voice Switch' off"
		cset "name='Headset Left Mixer HiFi Switch' off"
		cset "name='Headset Left Mixer Ext Switch' off"

		cset "name='EMU Right Mixer Voice Switch' off"
		cset "name='EMU Right Mixer HiFi Switch' off"
		cset "name='EMU Right Mixer Ext Switch' off"
		cset "name='EMU Left Mixer Voice Switch' off"
		cset "name='EMU Left Mixer HiFi Switch' off"
		cset "name='EMU Left Mixer Ext Switch' off"

		cset "name='Ext Left Enable Switch' off"
		cset "name='Ext Left Phase Invert Switch' off"
		cset "name='Ext Mono Playback Switch' off"
		cset "name='Ext Right Enable Switch' off"
		cset "name='HiFi Mono Playback Switch' off"
		cset "name='Call Volume' 0"
		cset "name='Hifi Left Phase Invert Switch' off"
		cset "name='Left Capture Route' off"
		cset "name='Right Capture Route' off"
		cset "name='Voice Loopback Switch' off"
		cset "name='Mic1 Capture Volume' 0"
		cset "name='Mic2 Capture Volume' 0"
	]
}
SectionDevice."Speaker" {
	Comment "Internal speaker"
	EnableSequence [
		cset "name='HiFi Mono Playback Switch' on"
		cset "name='Speaker Right Mixer HiFi Switch' on"
	]

	DisableSequence [
		cset "name='Speaker Right Mixer HiFi Switch' off"
		cset "name='HiFi Mono Playback Switch' off"
	]

	Value {
		PlaybackVolume "HiFi Playback Volume"
		PlaybackChannels 2
		PlaybackPriority 100
		PlaybackPCM "hw:${CardId},0"
	}
}
SectionDevice."Mic" {
	Comment "Internal Microphone"
	ConflictingDevice [
		"Headset"
	]
	EnableSequence [
		cset "name='Left Capture Route' 'Mic 2'"
		cset "name='Right Capture Route' 'Mic 1'"
	]
	DisableSequence [
		cset "name='Left Capture Route' off"
		cset "name='Right Capture Route' off"
	]
	Value {
		CapturePriority 100
		CapturePCM "hw:${CardId},1"
		CaptureChannels 2
	}
}
SectionDevice."Headset" {
	Comment "Headset Microphone"
	ConflictingDevice [
		"Mic"
	]
	EnableSequence [
		cset "name='Right Capture Route' 'Headset Mic'"
	]
	DisableSequence [
		cset "name='Right Capture Route' off"
	]
	Value {
		CapturePriority 200
		CapturePCM "hw:${CardId},1"
		CaptureChannels 2
		JackControl "Headphones Jack"
	}
}
SectionDevice."Headphones" {
	Comment "Headset"
	EnableSequence [
		cset "name='Headset Left Mixer HiFi Switch' on"
		cset "name='Headset Right Mixer HiFi Switch' on"
	]

	DisableSequence [
		cset "name='Headset Left Mixer HiFi Switch' off"
		cset "name='Headset Right Mixer HiFi Switch' off"
	]

	Value {
		PlaybackVolume "HiFi Playback Volume"
		PlaybackChannels 2
		PlaybackPriority 300
		PlaybackPCM "hw:${CardId},0"
		JackControl "Headphones Jack"
	}
}
